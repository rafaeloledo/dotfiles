down() {
	pamixer -d 2
	volume=$(pamixer --get-volume)
	[$volume -gt 0 ] && volume=$(expr $volume)
	notify-send -a "VOLUME" -u normal -i audio-volume-low-symbolic \
		-h int:value:"$volume" -h string:x-canonical-private-synchronous:volume \
		"Decreasing to $volume%"
	canberra-gtk-play -i dialog-error -d "error"
}

up() {
	pamixer -i 2
	volume=$(pamixer --get-volume)
	[ $volume -lt 100 ] && volume=$(expr $volume)
	notify-send -a "VOLUME" -u normal -i audio-volume-high-symbolic \
		-h int:value:"$volume" -h string:x-canonical-private-synchronous:volume \
		"Increasing to $volume%"
	canberra-gtk-play -i dialog-error -d "error"
}

mute() {
	muted="$(pamixer --get-mute)"
	if $muted; then
		pamixer -u
		notify-send -a "VOLUME" -u normal -i audio-volume-high-symbolic \
			-h string:x-canonical-private-synchronous:volume "UNMUTED"
	else
		pamixer -m
		notify-send -a "VOLUME" -u normal -i audio-volume-muted-symbolic \
			-h string:x-canonical-private-synchronous:volume "MUTED"
	fi
}

case "$1" in
up) up ;;
down) down ;;
mute) mute ;;
esac
