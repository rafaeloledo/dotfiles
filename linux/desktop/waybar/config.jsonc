{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "exclusive": true,

    "modules-left": [
        "custom/ws-prev",
        "ext/workspaces",
        "custom/ws-next",
        "custom/close",
        "custom/sep",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "pulseaudio",
        "custom/brightness",
        "battery",
        "tray"
    ],

    // ── Left ──────────────────────────────────────────────────────────

    "custom/ws-prev": {
        "format": "󰅁",
        "tooltip-format": "Previous workspace",
        "on-click": "$HOME/.local/scripts/previousworkspace"
    },

    "custom/ws-next": {
        "format": "󰅂",
        "tooltip-format": "Next workspace",
        "on-click": "$HOME/.local/scripts/nextworkspace"
    },

    "custom/close": {
        "format": "󰅖",
        "tooltip-format": "Close window",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-name": true,
        "active-only": false,
        "all-outputs": false
    },

    "custom/sep": {
        "format": "  ·  ",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 55,
        "separate-outputs": true,
        "rewrite": {
            "(.*)": " $1"
        }
    },

    // ── Center ────────────────────────────────────────────────────────

    "clock": {
        "format": "{:%A   %Y-%m-%d   %H · %M · %S}",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#c8a86a'><b>{}</b></span>",
                "weekdays": "<span color='#808090'>{}</span>",
                "today":    "<span color='#4fc8c8'><b>{}</b></span>"
            }
        }
    },

    // ── Right ─────────────────────────────────────────────────────────

    "network": {
        "interval": 5,
        "format-wifi":        "󰤨  {essid}",
        "format-ethernet":    "",
        "format-disconnected":"󰤭  offline",
        "format-linked":      "",
        "tooltip-format-wifi":"SSID: {essid}\nSignal: {signalStrength}%\n{ipaddr}  ↑{bandwidthUpBytes}  ↓{bandwidthDownBytes}",
        "on-click": "nm-connection-editor"
    },

    "cpu": {
        "format": "󰍛  {usage:02d}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰘚  {used:0.1f}G",
        "interval": 5,
        "tooltip-format": "used  {used:0.2f} G\nfree  {avail:0.2f} G\ntotal {total:0.2f} G"
    },

    "pulseaudio": {
        "format":       "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"],
            "headphone": "󰋋",
            "headset": "󰋎"
        },
        "scroll-step": 2,
        "on-click": "ags toggle volume-popup",
        "tooltip-format": "{desc}\n{volume}%"
    },

    "custom/brightness": {
        "exec": "ddc-slider waybar",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "exec-on-event": false,
        "cursor": false,
        "format": "{text}",
        "on-click": "sh -c 'ddc-slider popup >/dev/null 2>&1 &'",
        "on-scroll-up": "ddc-slider up",
        "on-scroll-down": "ddc-slider down",
        "tooltip": true
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format":          "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged":  "󰚥  {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip-format": "{timeTo}\n{capacity}% · {power:.1f} W"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
