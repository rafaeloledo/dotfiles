configuration {
    modes:               "drun,run,window";
    font:                "JetBrainsMono Nerd Font 11";
    terminal:            "ghostty";
    wayland-layer:       "overlay";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    matching:            "fuzzy";
    sorting-method:      "fzf";
    tokenize:            true;
    case-smart:          true;
    cycle:               true;
    fixed-num-lines:     false;
    max-history-size:    25;

    display-drun:        "APPS";
    display-run:         "EXEC";
    display-window:      "WIN";
    drun-display-format: "{name} [<span color='#7a7a8e' size='small'>· {generic}</span>]";
    window-format:       "{c}  ·  {t}";
}

@theme "yorha"
