[global]
    ### Display ###
    monitor = 0
    follow = keyboard

    ### Geometry ###
    width = (340, 420)
    height = (0, 200)
    origin = top-right
    offset = (16, 48)
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 420
    progress_bar_corner_radius = 4

    ### Layout ###
    indicate_hidden = yes
    separator_height = 0
    gap_size = 10

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14

    frame_width = 2
    frame_color = "#1d1d26"
    separator_color = "#1d1d26"

    corner_radius = 10
    icon_corner_radius = 8
    corners = all

    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false

    ### Text ###
    font = JetBrainsMono Nerd Font 11
    line_height = 4
    markup = full

    format = "<span foreground='#4fc8c8' weight='bold'>▸</span> <span size='small' foreground='#c8a86a' weight='semibold'>%a</span>\n<b><span foreground='#dcdce8'>%s</span></b>\n<span size='small' foreground='#7a7a8e'>%b</span>"

    alignment = left
    vertical_alignment = top
    ellipsize = middle
    ignore_newline = no
    word_wrap = yes
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 28
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/:/usr/share/icons/Papirus-Dark/16x16/actions/:/usr/share/icons/Papirus-Dark/16x16/animations/:/usr/share/icons/Papirus-Dark/16x16/apps/:/usr/share/icons/Papirus-Dark/16x16/categories/:/usr/share/icons/Papirus-Dark/16x16/emblems/:/usr/share/icons/Papirus-Dark/16x16/emotes/:/usr/share/icons/Papirus-Dark/16x16/devices/mimetypes:/usr/share/icons/Papirus-Dark/16x16/panel/:/usr/share/icons/Papirus-Dark/16x16/places/

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true

[urgency_low]
    background = "#0b0b0e"
    foreground = "#7a7a8e"
    frame_color = "#1d1d26"
    highlight = "#7a7a8e"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#13131a"
    foreground = "#dcdce8"
    frame_color = "#c8a86a"
    highlight = "#4fc8c8"
    timeout = 6
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#13131a"
    foreground = "#dcdce8"
    frame_color = "#c04848"
    highlight = "#c04848"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning

[volume]
    appname = "VOLUME"
    frame_color = "#4fc8c8"
    highlight = "#4fc8c8"
    format = "<span foreground='#4fc8c8' weight='bold'>♫</span> <span size='small' foreground='#c8a86a' weight='semibold'>AUDIO</span>\n<b><span foreground='#dcdce8'>%s</span></b>\n%p"
    timeout = 2
    set_stack_tag = volume

[keyboard]
    summary = "kbd is now*"
    frame_color = "#4fc8c8"
    format = "<span foreground='#4fc8c8' weight='bold'>⌨</span> <span size='small' foreground='#c8a86a'>INPUT</span>\n<b><span foreground='#dcdce8'>%s</span></b>"
    timeout = 2

[wallpaper]
    summary = "Set wallaper*"
    frame_color = "#c8a86a"
    format = "<span foreground='#c8a86a' weight='bold'>◈</span> <span size='small' foreground='#7a7a8e'>VISUAL</span>\n<span size='small' foreground='#7a7a8e'>%s</span>"
