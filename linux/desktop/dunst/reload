#!/usr/bin/env bash
set -euo pipefail

pkill dunst 2>/dev/null || true
dunst -config "${XDG_CONFIG_HOME:-$HOME/.config}/dunst/dunstrc" &

sleep 0.3

dunstify -u low    -a "System"     "Ghost link idle"           "No new transmissions on this channel."
dunstify -u normal -a "YoRHa"      "Pod 042 online"            "All systems nominal. Good morning, 9S."
dunstify -u critical -a "YoRHa"    "Hostile signature detected" "Goliath-class unit approaching sector 7."
dunstify -a "VOLUME" "Increasing to 67%" -h int:value:67 -i audio-volume-high-symbolic -r 2593 -u normal
dunstify -a "VOLUME" "Decreasing to 23%" -h int:value:23 -i audio-volume-low-symbolic -r 2593 -u normal
dunstify "kbd is now us"
