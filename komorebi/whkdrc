# whkd config — equivalent to Hyprland binds from dotfiles/wayland/hypr/hyprland.conf
# Main mod = Alt (SUPER/Win conflicts with Windows shell shortcuts)

.shell powershell

# App / system shortcuts
alt + q                : wt.exe                                 # terminal (was: ghostty)
alt + e                : explorer.exe                           # file manager (was: dolphin)
alt + r                : powershell -c "Start-Process -FilePath (Get-Command wt).Source"  # launcher placeholder; replace with flow-launcher / powertoys-run
alt + b                : start chrome
alt + n                : start "" "obsidian://"
alt + m                : komorebic stop                         # exit-ish (was: hyprshutdown)

# Window management — direct komorebi equivalents
alt + c                : komorebic close
alt + v                : komorebic toggle-float
alt + d                : komorebic toggle-float
alt + f                : komorebic toggle-maximize
alt + p                : komorebic toggle-monocle               # ~ pseudotile
alt + x                : komorebic flip-layout horizontal       # ~ togglesplit (was alt+j, now hjkl uses j)
alt + g                : komorebic toggle-window-container-behaviour   # ~ togglegroup (stack)
# alt+tab left to Windows native task switcher
# in-workspace cycle: use alt+arrows, or rebind below
# alt + grave            : komorebic cycle-focus next
# alt + shift + grave    : komorebic cycle-focus previous

# Focus (vim hjkl)
alt + h                : komorebic focus left
alt + j                : komorebic focus down
alt + k                : komorebic focus up
alt + l                : komorebic focus right

# Move window (shift + hjkl)
alt + shift + h        : komorebic move left
alt + shift + j        : komorebic move down
alt + shift + k        : komorebic move up
alt + shift + l        : komorebic move right

# Workspaces 1-10
alt + 1                : komorebic focus-workspace 0
alt + 2                : komorebic focus-workspace 1
alt + 3                : komorebic focus-workspace 2
alt + 4                : komorebic focus-workspace 3
alt + 5                : komorebic focus-workspace 4
alt + 6                : komorebic focus-workspace 5
alt + 7                : komorebic focus-workspace 6
alt + 8                : komorebic focus-workspace 7
alt + 9                : komorebic focus-workspace 8
alt + 0                : komorebic focus-workspace 9

# Move window to workspace
alt + shift + 1        : komorebic move-to-workspace 0
alt + shift + 2        : komorebic move-to-workspace 1
alt + shift + 3        : komorebic move-to-workspace 2
alt + shift + 4        : komorebic move-to-workspace 3
alt + shift + 5        : komorebic move-to-workspace 4
alt + shift + 6        : komorebic move-to-workspace 5
alt + shift + 7        : komorebic move-to-workspace 6
alt + shift + 8        : komorebic move-to-workspace 7
alt + shift + 9        : komorebic move-to-workspace 8
alt + shift + 0        : komorebic move-to-workspace 9

# Cycle workspaces (was: bracketleft/right, page_up/down)
alt + oem_4            : komorebic cycle-workspace previous     # [
alt + oem_6            : komorebic cycle-workspace next         # ]
alt + prior            : komorebic cycle-workspace previous     # PageUp
alt + next             : komorebic cycle-workspace next         # PageDown

# Reload
alt + shift + r        : komorebic reload-configuration

# Print screen — uses Windows native (Win+Shift+S already opens Snip & Sketch)
# print                : powershell -c "Start-Process ms-screenclip:"
